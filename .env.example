
# Configuración de Base de Datos Local

# 'postgres' es el usuario estándar por defecto. 
# Si la base de datos local no tiene contraseña, dejar DB_PASSWORD en blanco.
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=localhost

# (Opcional) 
# DATABASE_URL="postgres://postgres:tu_contraseña@localhost:5432/tarea_tecnica_ocr_development"



# Inteligencia Artificial (Gemini)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


# Cloudflare R2 (Opcional para desarrollo)


# En desarrollo, por defecto se usa el disco local.
R2_ACCOUNT_ID=tu_account_id_aqui
R2_ACCESS_KEY_ID=tu_access_key_aqui
R2_SECRET_ACCESS_KEY=tu_secret_key_aqui
R2_BUCKET=tu_bucket_aqui