<% content_for :title, "Revisar Boleta" %>

<%# Review screen for correcting OCR-extracted data before saving the receipt. %>
<div class="split-layout">
  <!-- Vista previa del comprobante -->
  <div>
    <div class="card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <span style="font-size: 0.875rem; font-weight: 600;">Comprobante adjunto</span>
        <%= receipt_status_badge(@receipt.status) %>
      </div>

      <% if @receipt.failed? %>
        <div class="alert alert-warning" style="font-size: 0.8125rem;">
          La extracción automática falló. Completa los datos manualmente o reintenta el procesamiento.
        </div>
        <%= button_to "Reintentar con IA", reprocess_receipt_path(@receipt),
            method: :post,
            class: "btn btn-secondary btn-sm",
            style: "margin-bottom: 1rem;" %>
      <% end %>

      <div class="document-preview-box">
        <% if @receipt.file.attached? %>
          <% if @receipt.file.content_type.to_s.start_with?("image/") %>
            <%= image_tag @receipt.file, class: "document-preview-img", alt: "Comprobante" %>
          <% elsif @receipt.file.content_type == "application/pdf" %>
            <iframe
              src="<%= rails_blob_path(@receipt.file, disposition: 'inline') %>"
              title="Vista previa del comprobante PDF"
              style="width: 100%; height: 480px; border: none; border-radius: var(--radius-sm);">
            </iframe>
            <div style="text-align: center; margin-top: 0.75rem;">
              <%= link_to "Abrir PDF en pestaña nueva",
                  rails_blob_path(@receipt.file, disposition: "inline"),
                  target: "_blank",
                  class: "btn btn-secondary btn-sm" %>
            </div>
          <% end %>
        <% else %>
          <p style="color: var(--text-dim); padding: 2rem; font-size: 0.85rem;">Sin archivo adjunto</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Formulario de edición -->
  <div>
    <div class="card">
      <div style="margin-bottom: 1.5rem;">
        <h1 class="card-title">Revisar datos</h1>
        <p class="card-subtitle">Verifica los datos extraídos antes de guardar.</p>
      </div>

      <%= form_with(model: @receipt, url: receipt_path(@receipt), method: :patch, local: true) do |f| %>

        <% if @receipt.errors.any? %>
          <div class="alert alert-danger">
            <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.85rem;">
              <% @receipt.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-grid">
          <div class="form-group full-width">
            <%= f.label :merchant_name, "Comercio / Razón Social", class: "form-label" %>
            <%= f.text_field :merchant_name, class: "form-control", placeholder: "Ej. Supermercado Lider" %>
          </div>

          <div class="form-group">
            <%= f.label :rut_emisor, "RUT Emisor", class: "form-label" %>
            <%= f.text_field :rut_emisor, class: "form-control", placeholder: "12.345.678-9" %>
          </div>

          <div class="form-group">
            <%= f.label :purchase_date, "Fecha de emisión", class: "form-label" %>
            <%= f.date_field :purchase_date, class: "form-control" %>
          </div>

          <div class="form-group">
            <%= f.label :document_number, "N° Folio", class: "form-label" %>
            <%= f.text_field :document_number,
                class: "form-control",
                placeholder: "Ej. 004829105",
                inputmode: "numeric",
                pattern: "\\d+",
                title: "Solo se permiten números (sin letras ni símbolos)" %>
          </div>

          <div class="form-group">
            <%= f.label :document_type, "Tipo de comprobante", class: "form-label" %>
            <%= f.text_field :document_type, class: "form-control", placeholder: "Boleta Electrónica" %>
          </div>

          <div class="form-group">
            <%= f.label :net_amount, "Neto ($ CLP)", class: "form-label" %>
            <%= f.number_field :net_amount, step: "1", class: "form-control", placeholder: "0" %>
          </div>

          <div class="form-group">
            <%= f.label :tax_amount, "IVA ($ CLP)", class: "form-label" %>
            <%= f.number_field :tax_amount, step: "1", class: "form-control", placeholder: "0" %>
          </div>

          <div class="form-group full-width">
            <%= f.label :total_amount, "Total ($ CLP) *", class: "form-label", style: "font-weight: 600; color: var(--text-main);" %>
            <%= f.number_field :total_amount, step: "1", class: "form-control", placeholder: "0", required: true, style: "font-weight: 600;" %>
          </div>
        </div>

        <!-- Botones de Acción DENTRO del formulario principal -->
        <div style="margin-top: 1.75rem; display: flex; justify-content: flex-end; align-items: center; gap: 0.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
          <%= link_to "Cancelar", receipts_path, class: "btn btn-secondary" %>
          <%= f.submit "Guardar boleta", class: "btn btn-primary", id: "save-receipt-btn" %>
        </div>
      <% end %>

      <div style="margin-top: 1rem; display: flex; justify-content: flex-start;">
        <%= button_to "Descartar",
            receipt_path(@receipt),
            method: :delete,
            class: "btn btn-danger btn-sm",
            data: { turbo_confirm: "¿Descartar este comprobante?" } %>
      </div>
    </div>
  </div>
</div>
